<?xml version="1.0" encoding="utf-8"?>
<!-- 频道行：高度和图标尺寸在 ChannelAdapter 里按屏幕等比换算 -->
<!--
  focusableInTouchMode 是必须的，不是可选优化：
  点过屏幕（含虚拟遥控器）后窗口会进入 touch mode，此时普通 focusable 的 View
  调 requestFocus() 会被静默拒绝，焦点留在 root 上，方向键就彻底没反应了。
  实测现象：按 OK 打开菜单后上下左右键毫无反应（build/c2.png）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_bg"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="0dp"
    android:paddingEnd="16dp"
    android:paddingBottom="0dp">

    <!-- 频道图标，离线打包在 assets/logos；高度几乎占满整行 -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginEnd="18dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <!-- 清晰度标签放一行，可横向滑动 -->
        <HorizontalScrollView
            android:id="@+id/metaScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none"
            android:singleLine="true">

            <LinearLayout
                android:id="@+id/metaRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
