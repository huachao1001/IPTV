<?xml version="1.0" encoding="utf-8"?>
<!--
  布局里的 dp/sp 只是 1080p 基准占位，真实尺寸在 MainActivity.applyScaleToViews()
  里按屏幕物理像素重新计算，因此同一块 1080p 屏不论上报 240dpi 还是 320dpi 都一致。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:keepScreenOn="true"
        app:use_controller="false" />

    <!-- 界面调试期用静态图代替直播画面，避免网络卡顿干扰布局调整 -->
    <ImageView
        android:id="@+id/previewImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/preview_still" />

    <!-- 触屏手势层：点按开列表、上下滑动换台 -->
    <View
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <com.iptv.live.ui.BufferingIndicator
        android:id="@+id/loading"
        android:layout_width="140dp"
        android:layout_height="182dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- ==================== 顶栏 ==================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/top_bar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="26dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="16dp">

        <!-- 正在播的台标：和台名同一行、在它左边。
             之前它单独挂在右下角（还和焦点预览台标叠在一起），
             屏幕上同时出现两个 logo，用户分不清哪个是"正在播"。
             尺寸按用户要求放大到原来的 2.5 倍（88x44dp -> 220x110dp），
             实际像素由 MainActivity.applyScaleToViews() 按屏高重算。 -->
        <ImageView
            android:id="@+id/infoLogo"
            android:layout_width="220dp"
            android:layout_height="110dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nowMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:alpha="0.6"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:alpha="0.75"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_btn"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="设置"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ==================== 左侧双栏抽屉 ==================== -->
    <LinearLayout
        android:id="@+id/drawer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:visibility="gone">

        <!-- 分组导航 -->
        <LinearLayout
            android:id="@+id/groupPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.30"
            android:background="@drawable/group_panel_bg"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="24dp"
            android:paddingEnd="12dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/groupLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="14dp"
                android:letterSpacing="0.14"
                android:text="分类"
                android:textColor="@color/text_tertiary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/groupList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:focusableInTouchMode="true"
                android:paddingBottom="12dp"
                android:scrollbars="none" />

            <!-- 列表概况放在左栏底部，右栏顶部不再占用空间 -->
            <TextView
                android:id="@+id/drawerSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:alpha="0.42"
                android:lineSpacingExtra="4dp"
                android:maxLines="3"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 设置 / 收起 沉到左栏底部 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnDrawerSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/settings_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:text="设置"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnClose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/settings_btn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp"
                    android:text="收起"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 频道列表 -->
        <LinearLayout
            android:id="@+id/channelPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.70"
            android:background="@drawable/channel_panel_bg"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="20dp"
                    android:scrollbars="none" />

                <!-- 上下渐隐：滚到边缘的半截行淡出，而不是被硬切一刀 -->
                <View
                    android:id="@+id/listFadeTop"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_gravity="top"
                    android:background="@drawable/list_fade_top" />

                <View
                    android:id="@+id/listFadeBottom"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/list_fade_bottom" />

                <TextView
                    android:id="@+id/emptyTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:alpha="0.5"
                    android:paddingStart="22dp"
                    android:paddingTop="30dp"
                    android:paddingEnd="22dp"
                    android:gravity="center_horizontal"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== 右侧清晰度面板 ====================
         按规则 1/3/4：与左侧抽屉同属<b>一个菜单</b>，OK 键同时开、同时关；
         上下左右键在菜单内部移动焦点，左列表可跳到右档位。

         宽度按规则 4 收窄到屏幕 16%：只需要放下 `1080P` 四个字，
         再宽就白占画面。样式与左侧分组项同源（10dp 圆角、焦点实心蓝）。

         渐变是"右实左虚"，与左侧"左实右虚"镜像，所以内容右对齐——
         左侧文字贴着不透明的左边，右侧就得贴着不透明的右边，
         否则文字落在透明区，压在亮画面上看不清。 -->
    <LinearLayout
        android:id="@+id/qualityPanel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/quality_panel_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="14dp"
        android:paddingBottom="26dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/qualityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="10dp"
            android:letterSpacing="0.14"
            android:text="清晰度"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/qualityScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/qualityRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 右下角浮层已整体删除。
         原来这里有<b>两个</b> logo 叠在一起：previewLogo（焦点预览）和
         infoLogo（正在播放），各自有一套显示/淡出逻辑，屏幕上同时出现两个
         台标，用户根本分不清哪个是"正在播"。
         现在只保留一处：infoLogo 移到左上角顶栏，和台名/分组放在一起，
         焦点预览那套（含其淡入淡出、Wrap 位置计算）一并去掉。 -->

    <!-- 提示浮层：独立叠在底栏上方，不参与底栏布局，弹出时不会把信息条顶起来 -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/hint_bg"
        android:paddingStart="26dp"
        android:paddingTop="12dp"
        android:paddingEnd="26dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
